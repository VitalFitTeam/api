# Configuración de la Base de Datos Local
# -------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=user_example
DB_PASSWORD=password_example
DB_NAME=vitalfit

# Cadena de Conexión Completa (Uso en desarrollo/docker)
# Usualmente el usuario/contraseña/host se obtienen de las variables anteriores
DB_ADDR=postgres://admin:adminpassword@db:5432/vitalfit?sslmode=disable

# Configuración de la Base de Datos de Producción
# ---------------------------------------------
# ¡IMPORTANTE! Reemplazar con la cadena de conexión real de producción
DB_ADDR_PROD=postgresql://user_prod_example:password_prod_example@host_prod_example:5432/database_prod_example

# Configuración de Conexiones a la Base de Datos
# ---------------------------------------------
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m

# Configuración del Servidor y Entorno
# ------------------------------------
ADDR=:8080
EXTERNAL_LINK=localhost:8080
ENV=development

# Lista Blanca (CORS)
# -------------------
WHITE_LIST=http://localhost:3000,http://localhost:8081,http://localhost:8080,http://localhost:8000

# Configuración de Resend (Servicio de Email)
# ------------------------------------------
# ¡IMPORTANTE! Usar tu clave de API de Resend real
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_RESEND_EMAIL="Acme <info@vitalfitteam.xyz>"

# Configuración de JSON Web Token (JWT)
# -------------------------------------
# Clave secreta para firmar/verificar tokens. Debe ser larga y aleatoria.
JWT_SECRET=a_super_secret_and_long_random_string_for_jwt
JWT_ISS=vitalfit

# Credenciales Iniciales de Administrador (Para Seeding/Inicialización)
# -------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password_example

